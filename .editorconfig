# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Golden fixtures are compared byte-for-byte; never let an editor touch them.
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
